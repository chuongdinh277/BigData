{
  "task": "P3",
  "description": "Gold table for 90-day post-discharge all-cause mortality (patients.dod), prediction at dischtime (alive discharge, excluding hospice). One row per index hadm_id.",
  "schema_version": "0.1",
  "primary_key": [
    "hadm_id"
  ],
  "group_key": "subject_id",
  "label": "label_mort90",
  "id_columns": [
    {
      "name": "subject_id",
      "type": "long"
    },
    {
      "name": "hadm_id",
      "type": "long"
    },
    {
      "name": "admittime",
      "type": "timestamp"
    },
    {
      "name": "prediction_time",
      "type": "timestamp",
      "note": "= dischtime"
    },
    {
      "name": "anchor_year_group",
      "type": "string",
      "role": "split_drift_only"
    }
  ],
  "label_columns": [
    {
      "name": "label_mort90",
      "type": "int",
      "values": [
        0,
        1
      ]
    }
  ],
  "subgroup_only_columns": [
    {
      "name": "race_group",
      "type": "string",
      "note": "fairness evaluation only, never a model input"
    },
    {
      "name": "insurance",
      "type": "string",
      "note": "fairness evaluation only, never a model input"
    },
    {
      "name": "hf_primary",
      "type": "int",
      "note": "HF is seq_num=1; current-admission ICD → subgroup only"
    },
    {
      "name": "icd_version_group",
      "type": "string",
      "values": [
        "ICD9",
        "ICD10",
        "MIXED"
      ]
    }
  ],
  "feature_columns": {
    "demographic_admission": [
      {
        "name": "age",
        "type": "double"
      },
      {
        "name": "gender_male",
        "type": "int"
      },
      {
        "name": "admission_type_group",
        "type": "string",
        "values": [
          "EMERGENCY",
          "URGENT",
          "OBSERVATION",
          "ELECTIVE",
          "UNKNOWN"
        ]
      },
      {
        "name": "admission_location_group",
        "type": "string",
        "values": [
          "EMERGENCY_ROOM",
          "TRANSFER",
          "REFERRAL",
          "OTHER",
          "UNKNOWN"
        ]
      },
      {
        "name": "came_from_ed",
        "type": "int"
      },
      {
        "name": "icu_any",
        "type": "int",
        "note": "any ICU stay during the admission"
      }
    ],
    "history": [
      {
        "name": "n_prior_adm_365d",
        "type": "int"
      },
      {
        "name": "n_prior_hf_adm",
        "type": "int"
      },
      {
        "name": "first_admission",
        "type": "int"
      },
      {
        "name": "days_since_last_discharge",
        "type": "double",
        "nullable": true
      },
      {
        "name": "hx_ckd",
        "type": "int"
      },
      {
        "name": "hx_diabetes",
        "type": "int"
      },
      {
        "name": "hx_afib",
        "type": "int"
      },
      {
        "name": "hx_copd",
        "type": "int"
      },
      {
        "name": "hx_hypertension",
        "type": "int"
      },
      {
        "name": "hx_cad",
        "type": "int"
      },
      {
        "name": "hx_prior_mi",
        "type": "int"
      },
      {
        "name": "hx_stroke",
        "type": "int"
      },
      {
        "name": "omr_bmi_last",
        "type": "double",
        "nullable": true
      },
      {
        "name": "omr_weight_last",
        "type": "double",
        "nullable": true
      },
      {
        "name": "omr_sbp_last",
        "type": "double",
        "nullable": true
      },
      {
        "name": "omr_egfr_last",
        "type": "double",
        "nullable": true
      }
    ],
    "stay": [
      {
        "name": "los_days",
        "type": "double",
        "note": "(dischtime - admittime) in days; allowed at discharge"
      },
      {
        "name": "icu_days",
        "type": "double",
        "note": "total ICU time within the admission (clipped to [admittime, dischtime])"
      },
      {
        "name": "discharge_location_group",
        "type": "string",
        "values": [
          "HOME",
          "HOME_HEALTH",
          "FACILITY",
          "OTHER",
          "UNKNOWN"
        ]
      },
      {
        "name": "n_diagnoses",
        "type": "int",
        "note": "distinct ICD codes of the current admission (coded at discharge)"
      },
      {
        "name": "dx_ckd",
        "type": "int",
        "note": "comorbidity coded in the CURRENT admission (allowed at discharge)"
      },
      {
        "name": "dx_diabetes",
        "type": "int",
        "note": "comorbidity coded in the CURRENT admission (allowed at discharge)"
      },
      {
        "name": "dx_afib",
        "type": "int",
        "note": "comorbidity coded in the CURRENT admission (allowed at discharge)"
      },
      {
        "name": "dx_copd",
        "type": "int",
        "note": "comorbidity coded in the CURRENT admission (allowed at discharge)"
      },
      {
        "name": "dx_hypertension",
        "type": "int",
        "note": "comorbidity coded in the CURRENT admission (allowed at discharge)"
      },
      {
        "name": "dx_cad",
        "type": "int",
        "note": "comorbidity coded in the CURRENT admission (allowed at discharge)"
      },
      {
        "name": "dx_prior_mi",
        "type": "int",
        "note": "comorbidity coded in the CURRENT admission (allowed at discharge)"
      },
      {
        "name": "dx_stroke",
        "type": "int",
        "note": "comorbidity coded in the CURRENT admission (allowed at discharge)"
      }
    ],
    "labs": {
      "items": [
        "ntprobnp",
        "creatinine",
        "bun",
        "sodium",
        "potassium",
        "chloride",
        "bicarbonate",
        "anion_gap",
        "glucose",
        "hemoglobin",
        "hematocrit",
        "wbc",
        "platelet",
        "rdw",
        "troponin_t",
        "lactate",
        "albumin",
        "magnesium",
        "bilirubin",
        "inr"
      ],
      "suffixes": {
        "_first": "double",
        "_min": "double",
        "_max": "double",
        "_last": "double",
        "_missing": "int"
      },
      "extra": [
        {
          "name": "n_lab_tests_stay",
          "type": "int"
        }
      ],
      "windows": {
        "_first/_min/_max/_missing": "[admittime - 6h, dischtime]",
        "_last": "[dischtime - 48h, dischtime]"
      }
    },
    "vitals_icu": [
      {
        "name": "hr_mean",
        "type": "double",
        "nullable": true,
        "note": "whole stay [admittime, dischtime]"
      },
      {
        "name": "hr_max",
        "type": "double",
        "nullable": true,
        "note": "whole stay [admittime, dischtime]"
      },
      {
        "name": "sbp_min",
        "type": "double",
        "nullable": true,
        "note": "whole stay [admittime, dischtime]"
      },
      {
        "name": "sbp_mean",
        "type": "double",
        "nullable": true,
        "note": "whole stay [admittime, dischtime]"
      },
      {
        "name": "dbp_mean",
        "type": "double",
        "nullable": true,
        "note": "whole stay [admittime, dischtime]"
      },
      {
        "name": "mbp_min",
        "type": "double",
        "nullable": true,
        "note": "whole stay [admittime, dischtime]"
      },
      {
        "name": "rr_mean",
        "type": "double",
        "nullable": true,
        "note": "whole stay [admittime, dischtime]"
      },
      {
        "name": "rr_max",
        "type": "double",
        "nullable": true,
        "note": "whole stay [admittime, dischtime]"
      },
      {
        "name": "spo2_min",
        "type": "double",
        "nullable": true,
        "note": "whole stay [admittime, dischtime]"
      },
      {
        "name": "temp_max_c",
        "type": "double",
        "nullable": true,
        "note": "whole stay [admittime, dischtime]"
      },
      {
        "name": "vitals_missing",
        "type": "int"
      }
    ]
  },
  "forbidden_columns": [
    "deathtime",
    "hospital_expire_flag",
    "dod",
    "next_admittime",
    "next_hadm_id",
    "days_to_readmission",
    "days_to_death",
    "readmit_hadm_id"
  ],
  "storage": "s3a://heartguard-mimic-group11/gold/p3/<data_version>/ (Parquet)",
  "prediction_time": "dischtime of the index admission"
}
