# Sao chép thành .env (KHÔNG commit .env). Không đặt access key AWS ở đây: EC2 dùng IAM Role.
AWS_REGION=us-east-1

# ---------- Spark (data_spark/) ----------
HG_SPARK_MASTER=local[*]          # cụm standalone: spark://<ip-private-master>:7077 (deploy/spark/cluster.sh)
HG_DRIVER_MEMORY=8g
HG_SHUFFLE_PARTITIONS=24          # 2–3 × tổng số core
HG_HADOOP_AWS=3.3.4               # khớp Hadoop của Spark 3.5.x
# HG_SPARK_CONF=spark.executor.memory=10g,spark.executor.cores=3
# HG_EVENT_LOG=file:///var/tmp/spark-events
# HG_LOCAL=1                      # chạy hoàn toàn local với dữ liệu giả (không S3)

# ---------- Học máy (ml/) ----------
HG_TASK=p1                        # p1 | p2 | p3

# ---------- Ứng dụng (deploy/docker-compose.yml) ----------
POSTGRES_PASSWORD=doi-mat-khau-nay
MODEL_SOURCE=local                # local: artifacts/models · s3: tải gói từ MODEL_S3_PREFIX
MODEL_S3_PREFIX=s3://heartguard-mimic-group11/model-artifacts
MODEL_VERSION_P1=                 # trống = phiên bản mới nhất
MODEL_VERSION_P2=
MODEL_VERSION_P3=
TASKS=p1,p2,p3
WEB_PORT=8080
CORS_ORIGINS=http://localhost:8080
